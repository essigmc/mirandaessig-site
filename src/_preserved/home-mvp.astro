---
import Base from '../layouts/Base.astro';
---
<Base title="Miranda Essig — better business, and giving back through health">
  <section class="mx-auto max-w-6xl px-5 py-12 md:py-20 grid md:grid-cols-2 gap-10 items-center">
    <div>
      <h1 class="text-4xl md:text-5xl font-extrabold leading-[1.1] tracking-tight">I build better businesses — and give back through health.</h1>
      <p class="mt-6 text-lg text-muted max-w-prose">I'm Miranda, an MBA and product owner. By day I help build better products and businesses. On the side I host <span class="font-semibold text-ink">Ask Me Anything</span>, a free health &amp; fitness podcast — because giving back to people is what I care about most.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/podcast" class="inline-block rounded-full text-white font-medium px-7 py-3 hover:opacity-90 transition" style="background-color:#bd5a80">Ask Me Anything — the podcast →</a>
        <a href="mailto:mirandaessig@gmail.com" class="inline-block rounded-full border border-line text-ink font-medium px-7 py-3 hover:bg-white transition">Get in touch</a>
      </div>
    </div>
    <div>
      <img src="/hero-illustration.webp" width="904" height="848" alt="Miranda Essig, illustrated" class="w-full rounded-2xl border border-line" />
    </div>
  </section>
</Base>
