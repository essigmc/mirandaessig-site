---
import Base from '../layouts/Base.astro';
---
<Base title="Health Focus — Miranda Essig" description="To encourage individuals to reach their optimal health, connecting food and movement back to longevity through community reinforcement.">
  <section style="background-color:#bd5a80" class="text-white">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <p class="uppercase tracking-widest text-white/80 text-sm">Health Focus</p>
      <h1 class="mt-2 text-3xl md:text-5xl font-extrabold max-w-3xl">Pursuing a healthy body & mind</h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl">To encourage individuals to reach their optimal health, connecting food and movement back to longevity through community reinforcement.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-14 grid md:grid-cols-3 gap-10">
    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">The science</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Nutrition science</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Gut biome</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Pesticides & food quality</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Long strong</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">The Long Strong Ladder</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Longevity</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Training & movement</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">The show</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">The Long Strongs</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Call the show</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">The 7 Baby Steps</a></li>
      </ul>
    </div>
  </section>
</Base>
