---
import Base from '../layouts/Base.astro';
const services = [
  { t: 'Business model and financials', d: 'A clear-eyed look at how the business makes money: unit economics, menu and product mix, pricing, margins, and where profit is leaking.' },
  { t: 'SEO and online presence', d: 'Get found by the people already searching — local SEO, site structure, Google Business Profile, and content that ranks.' },
  { t: 'Tools and automation fit', d: 'Which software and physical tools actually fit your operation, and which are just hype.' },
  { t: 'SOPs and operations', d: 'Turn how things should run into standard operating procedures your team can actually follow.' },
];
---
<Base title="Business Consulting — Miranda Essig" description="Hands-on help for food and hospitality businesses: business model, financials, SEO, tools, automation, and SOPs.">
  <section style="background-color:#2f6f4f" class="text-white">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <p class="uppercase tracking-widest text-white/80 text-sm">Business Consulting</p>
      <h1 class="mt-2 text-3xl md:text-5xl font-extrabold max-w-3xl">Make your food business run leaner and more profitable.</h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl">Hands-on help for restaurants, catering, quick-serve, vending, and meal-service operators — from the business model and the numbers to SEO, tooling, and day-to-day operations.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-14 grid md:grid-cols-2 gap-5">
    {services.map((s) => (
      <div class="rounded-2xl border border-line bg-white p-6">
        <h2 class="text-xl font-semibold">{s.t}</h2>
        <p class="text-muted mt-2 leading-relaxed">{s.d}</p>
      </div>
    ))}
  </section>
  <section class="mx-auto max-w-3xl px-5 pb-20">
    <h2 class="text-2xl font-bold">Who this is for</h2>
    <p class="mt-3 text-lg text-muted leading-relaxed">Owners and operators who know something could be better but don't have time to map it themselves — especially catering, multi-location, and food businesses adopting new tools.</p>
    <a href="mailto:mirandaessig@gmail.com" class="inline-block mt-6 rounded-full bg-biz text-white font-medium px-7 py-3 hover:bg-biz-ink transition">Get in touch</a>
  </section>
</Base>
