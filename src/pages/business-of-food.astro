---
import Base from '../layouts/Base.astro';
---
<Base title="Business of Food — Miranda Essig" description="To understand the tools, technology and industries that touch our food and assist businesses in building better products and services.">
  <section style="background-color:#2f6f4f" class="text-white">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <p class="uppercase tracking-widest text-white/80 text-sm">Business of Food</p>
      <h1 class="mt-2 text-3xl md:text-5xl font-extrabold max-w-3xl">How food gets to individuals</h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl">To understand the tools, technology and industries that touch our food and assist businesses in building better products and services.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-14 grid md:grid-cols-3 gap-10">
    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Explore</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Industry Hub</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Software & tools</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Physical automation</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">By segment</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Restaurants</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Quick-serve</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Vending</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Meal service</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Deep dives</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Vertical integration</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Price vs production tradeoffs</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Sub-industries</a></li>
      </ul>
    </div>
  </section>
</Base>
