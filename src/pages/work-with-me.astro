---
import Base from '../layouts/Base.astro';
import { href } from '../utils/href.js';

const services = [
  { title: 'Business model & financials review', body: 'A clear-eyed look at how the business makes money: unit economics, menu/product mix, pricing, margins, and where the profit is actually leaking.' },
  { title: 'SEO & online presence', body: 'Get found by the people already searching for you — local SEO, site structure, Google Business Profile, and content that ranks.' },
  { title: 'Tools & automation fit', body: 'Which software and physical tools actually fit your operation (and which are hype). Grounded in the industry hub I maintain.' },
  { title: 'SOPs & operations', body: 'Turn the way things "should" run into standard operating procedures your team can actually follow.' },
];
---
<Base title="Work With Me — Miranda Essig" description="Consulting for food & hospitality businesses: business model, financials, SEO, tools, automation, and SOPs.">
  <section class="hero">
    <p class="eyebrow">Consulting</p>
    <h1>Practical help for food & hospitality businesses.</h1>
    <p class="lead">
      Restaurants, catering, quick-serve, vending, and meal-service operators: I help you find the
      places to make more money and run more smoothly — from the business model and the numbers to
      SEO, tooling, and day-to-day operations.
    </p>
  </section>

  <div class="card-grid">
    {services.map((s) => (
      <article class="card">
        <h3>{s.title}</h3>
        <p>{s.body}</p>
      </article>
    ))}
  </div>

  <h2>Who this is for</h2>
  <p class="lead">Owners and operators who know something could be better but don't have time to map it themselves — especially catering, multi-location, and food businesses adopting new tools.</p>

  <p class="cta-row"><a class="btn" href="mailto:mirandaessig@gmail.com">Get in touch</a></p>
  <p class="muted" style="margin-top:12px">Draft copy — we'll refine your services and add packages/pricing once you decide how you want to sell.</p>
</Base>
