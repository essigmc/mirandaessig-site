---
import Base from '../layouts/Base.astro';

const heroImg = 'https://cdn.openart.ai/openart-ai/production/2026-08/create-image/YkM0VpvnTPrkFU78G0Mf/image_1786835569532_f166b388_1786835569781_d77a2b2a.png';

const personas = [
  { t: 'Newly pre-diabetic', d: "Your doctor flagged your A1C and sent you home with a pamphlet. You don't know if you need medication or just a different way of eating, and you don't know where to start." },
  { t: "Can't keep up with your kids", d: "You're winded at the park. You keep saying you'll start after the holidays, then after school, then after the new year. The kids keep getting faster." },
  { t: 'Postpartum and stuck', d: "Your body changed and you don't quite recognize it. You've tried to get back on track a dozen times, but you're sleep-deprived and short on hours." },
  { t: 'Watching a parent decline', d: "Your mom has dementia. Your dad's on oxygen. You don't want that to be your kids' future, and you want to know what to actually do about it." },
  { t: 'Living with PCOS', d: "You've been told your hormones make weight loss harder. Your doctor manages the symptoms, but nobody talks about the lifestyle changes that move the needle." },
  { t: 'Started and stopped a hundred times', d: "Whole30, Weight Watchers, Peloton, three gym memberships. Nothing stuck. You're not lazy, you just haven't had a system that works." },
];

const jsonld = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "PodcastSeries",
  "name": "Ask Me Anything with Miranda Essig",
  "url": "https://mirandaessig.com/podcast",
  "description": "A free call-in health and fitness podcast for people at a health turning point. Nutrition, weight loss, gut health, prediabetes, heart health, dementia and cancer prevention, and longevity basics.",
  "inLanguage": "en-US",
  "image": heroImg,
  "author": { "@type": "Person", "name": "Miranda Essig" },
  "about": ["nutrition","weight loss","gut microbiome","exercise","diabetes","prediabetes","cardiovascular health","dementia","cancer prevention","longevity","metabolic health","PCOS","postpartum weight loss"]
});

const ways = [
  { icon: '📞', title: 'Call In Live', body: "Feel free to call. I'm usually free weekdays 12–1pm EST and on weekends. Come with a little background about yourself and your question, and we'll talk for 5 to 15 minutes. Return callers are always welcome.", cta: 'call' },
  { icon: '📅', title: 'Schedule a Call', body: 'Like to plan things out? Schedule a time to ask your question during my normal availability.', cta: 'calendly' },
  { icon: '✉️', title: 'Submit a Question', body: 'Not comfortable calling? Write it out instead. I answer submitted questions on the show.', cta: 'form' },
];

const topics = [
  { icon: '🥗', title: 'Nutrition & Diet', body: 'Real food strategies, not fad diets' },
  { icon: '⚖️', title: 'Weight Loss', body: 'Sustainable approaches backed by science' },
  { icon: '🦠', title: 'Gut Microbiome', body: 'The second brain and how to feed it' },
  { icon: '🏃‍♀️', title: 'Exercise & Movement', body: 'What actually moves the needle' },
  { icon: '🩸', title: 'Diabetes', body: 'Blood sugar, insulin resistance & reversal' },
  { icon: '❤️', title: 'Cardiovascular Health', body: 'Heart disease prevention & recovery' },
  { icon: '🧠', title: 'Dementia & Brain Health', body: 'Protecting your mind as you age' },
  { icon: '🎗️', title: 'Cancer Prevention', body: 'Lifestyle factors that matter most' },
];

const stats = [
  { n: '100%', l: 'Free — always' },
  { n: '8', l: 'Health topics covered' },
  { n: 'Every week', l: 'New episodes + callbacks' },
];
---
<Base
  title="Ask Me Anything: a free call-in health & fitness podcast | Miranda Essig"
  description="A free call-in podcast for people at a health turning point. Straight talk on nutrition, weight loss, gut health, prediabetes, heart health, and avoiding dementia and cancer. Call in with your question and I'll help you find where to start."
  image={heroImg}
  keywords="free health podcast, call-in health show, health and fitness podcast, prediabetes, reverse prediabetes, weight loss motivation, postpartum weight loss, PCOS weight loss, metabolic health, longevity basics, avoid diabetes, heart health, dementia prevention, cancer prevention, live long and strong"
>
  <link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
  <script src="https://assets.calendly.com/assets/external/widget.js" is:inline async></script>
  <script type="application/ld+json" is:inline set:html={jsonld} slot="head"></script>

  <!-- Hero -->
  <section class="mx-auto max-w-6xl px-5 py-8 md:py-12 grid md:grid-cols-2 gap-8 md:gap-10 items-center">
    <div>
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#bd5a80">Ask Me Anything · Health &amp; Fitness</p>
      <h1 class="font-serif mt-3 text-3xl sm:text-4xl md:text-5xl font-semibold leading-[1.1] tracking-tight">Got a health question? Call in to the show.</h1>
      <p class="mt-4 text-base md:text-lg text-muted max-w-prose">Hey I'm Miranda! I am not a doctor, not a certified trainer, or an athlete, just a science novice who's read a ton about health and longevity, lives it every day, and wants to give back. This is a free and regular encouragement podcast on the basics of avoiding or lessening cancer, diabetes, heart trouble, and memory loss.</p>
      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="tel:+17577164154" class="inline-flex items-center gap-3 rounded-full px-6 sm:px-8 py-4 text-white font-semibold text-lg hover:opacity-90 transition" style="background-color:#33502a">
          <span aria-hidden="true">📞</span> Call (757) 716‑4154
        </a>
        <a href="#connect" class="inline-flex items-center rounded-full px-6 py-4 font-medium border-2 transition hover:bg-white/60" style="border-color:#33502a;color:#33502a">More ways to connect</a>
      </div>
      <p class="mt-3 text-sm text-muted">Weekdays 12–1pm EST and weekends. Leave a voicemail anytime and I'll call you back.</p>
    </div>
    <div>
      <img src={heroImg} alt="Miranda hosting the Ask Me Anything health and fitness podcast" class="w-full max-w-[270px] md:max-w-none md:h-[440px] md:w-auto mx-auto md:mx-0 md:ml-auto rounded-2xl" />
    </div>
  </section>

  <!-- Who this is for -->
  <section style="background-color:#f4ecdd">
    <div class="mx-auto max-w-6xl px-5 py-12 md:py-20 text-center">
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#c15a4a">Who this is for</p>
      <h2 class="font-serif mt-3 text-3xl md:text-5xl font-semibold" style="color:#33502a">Sound like you?</h2>
      <p class="mt-4 text-lg text-muted max-w-2xl mx-auto leading-relaxed">This show is for people at a turning point. You got a wake-up call and you're ready to do something about it. Maybe one of these is you.</p>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-3 gap-5 text-left">
        {personas.map((x) => (
          <div class="rounded-2xl bg-white p-6">
            <h3 class="font-serif text-lg" style="color:#33502a">{x.t}</h3>
            <p class="mt-2 text-muted leading-relaxed">{x.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we're up against -->
  <section style="background-color:#2c4520" class="text-white">
    <div class="mx-auto max-w-3xl px-5 py-12 md:py-20 text-center">
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#c9a24a">What we're up against</p>
      <h2 class="font-serif mt-3 text-3xl md:text-5xl font-semibold" style="color:#f5efe2">A system that isn't built for your health</h2>
      <p class="mt-6 text-lg leading-relaxed" style="color:#cdd6c2">Food companies profit when you eat more, so the cheapest, tastiest food is built to keep you coming back. Hospitals are set up well to treat you once you get a major illness. Almost no one in the whole setup makes money when you're actually well.</p>
      <p class="mt-4 text-lg leading-relaxed" style="color:#cdd6c2">It isn't that doctors don't care. They're stretched thin and burnt out, and they know lifestyle change is hard to prescribe and even harder to get people to take seriously. There's also no drug company paying them a cut to recommend a walk and more protein. Our health care simply wasn't designed for prevention. That's just not what it's built to do.</p>
      <p class="mt-4 text-lg leading-relaxed" style="color:#cdd6c2">So if getting healthy has felt impossible, it isn't because you're weak. The whole thing is pointed the other way, and that's what we're here for. Think of us as your community. Call in anytime with your questions, and let's work toward a long, healthy life so you can be there for the people who count on you.</p>
    </div>
  </section>

  <!-- Three ways to connect -->
  <section id="connect" class="scroll-mt-16" style="background-color:#33502a">
    <div class="mx-auto max-w-6xl px-5 py-12 md:py-20 text-center">
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#c9a24a">Get in touch</p>
      <h2 class="font-serif mt-3 text-3xl md:text-5xl font-semibold" style="color:#f5efe2">Three ways to connect</h2>
      <p class="mt-3 text-lg" style="color:#c7d0bb">I read every message. If I can't answer live, I'll call you back.</p>
      <div class="mt-12 grid md:grid-cols-3 gap-6 text-left">
        {ways.map((w) => (
          <div class="rounded-2xl p-7 flex flex-col" style="background-color:rgba(255,255,255,0.06);border:1px solid rgba(255,255,255,0.12)">
            <div class="text-4xl" aria-hidden="true">{w.icon}</div>
            <h3 class="font-serif text-xl mt-4" style="color:#f5efe2">{w.title}</h3>
            <p class="mt-3 leading-relaxed flex-1" style="color:#c7d0bb">{w.body}</p>
            <div class="mt-6">
              {w.cta === 'call' && (<a href="tel:+17577164154" class="inline-block rounded-full px-6 py-2.5 font-medium text-white" style="background-color:#d16b5a">(757) 716‑4154</a>)}
              {w.cta === 'calendly' && (<a href="#" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/mirandaessig/15min'});return false;" class="inline-block rounded-full px-6 py-2.5 font-medium" style="background-color:#c9a24a;color:#2a2410">Schedule a Call</a>)}
              {w.cta === 'form' && (<button type="button" onclick="document.getElementById('qmodal').classList.remove('hidden')" class="inline-block rounded-full px-6 py-2.5 font-medium border-2" style="border-color:rgba(255,255,255,0.4);color:#f5efe2">Write to Me</button>)}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- What we cover -->
  <section style="background-color:#f4ecdd">
    <div class="mx-auto max-w-6xl px-5 py-12 md:py-20 text-center">
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#c15a4a">What we cover</p>
      <h2 class="font-serif mt-3 text-3xl md:text-5xl font-semibold" style="color:#33502a">Your questions, answered</h2>
      <p class="mt-4 text-lg text-muted max-w-2xl mx-auto leading-relaxed">We won't get into specifics. I'm not going to recommend a particular diet, workout routine, or weight-loss plan. Just the everyday basics that actually move the needle, explained so they're easy to follow.</p>
      <div class="mt-12 grid sm:grid-cols-2 lg:grid-cols-4 gap-5 text-left">
        {topics.map((t) => (
          <div class="rounded-2xl bg-white p-6">
            <div class="text-3xl" aria-hidden="true">{t.icon}</div>
            <h3 class="font-serif text-lg mt-4" style="color:#33502a">{t.title}</h3>
            <p class="mt-2 text-muted leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- About the show -->
  <section style="background-color:#33502a">
    <div class="mx-auto max-w-4xl px-5 py-12 md:py-20 text-center">
      <p class="uppercase tracking-widest text-sm font-semibold" style="color:#c9a24a">About the show</p>
      <h2 class="font-serif mt-3 text-3xl md:text-5xl font-semibold" style="color:#f5efe2">Science for the rest of us</h2>
      <p class="mt-6 text-lg leading-relaxed" style="color:#cdd6c2">It's a call-in show, so wherever you are with your health, we start right there. We're creating a consistent community dialog about health and answering your questions. Never thought about any of this? Perfect. Already deep in it? Great. No question is too basic, and you don't need to understand the world inside your body to pick up the phone.</p>
      <p class="mt-4 text-lg leading-relaxed" style="color:#cdd6c2">A lot of great science is coming out on health and longevity, but most of it's buried in jargon. My job is to translate it, to turn the latest research into something simple you can actually use, for free. You shouldn't need a biology degree to take care of yourself.</p>
      <p class="mt-4 text-lg leading-relaxed" style="color:#cdd6c2">I'm a chubby kid at heart who fell deep into the science of longevity and couldn't stop reading. I started and stopped a hundred times before any of it stuck, and that's exactly why I get it.</p>
      <p class="font-serif mt-8 text-xl md:text-2xl leading-relaxed" style="color:#f5efe2">Do it for the people who count on you. Show up for yourself now so you can keep showing up for them. Come back each week, stay consistent, and remember you're not doing this alone. We're in this together.</p>
    </div>
  </section>

  <!-- Closing call to action -->
  <section style="background-color:#f4ecdd">
    <div class="mx-auto max-w-3xl px-5 py-12 md:py-20 text-center">
      <h2 class="font-serif text-3xl md:text-4xl font-semibold" style="color:#33502a">Your first step is a phone call.</h2>
      <p class="mt-3 text-lg text-muted">Weekdays 12–1pm EST and weekends. Not around? Leave a voicemail anytime and I'll call you back.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="tel:+17577164154" class="inline-flex items-center gap-2 rounded-full px-7 py-3.5 text-white font-medium hover:opacity-90 transition" style="background-color:#33502a"><span aria-hidden="true">📞</span> Call (757) 716-4154</a>
        <a href="#" onclick="Calendly.initPopupWidget({url: 'https://calendly.com/mirandaessig/15min'});return false;" class="inline-flex items-center rounded-full px-7 py-3.5 font-medium border-2 hover:bg-white transition" style="border-color:#33502a;color:#33502a">Schedule a call</a>
      </div>
    </div>
  </section>

  <!-- Disclaimers -->
  <section class="mx-auto max-w-2xl px-5 py-10 text-sm text-muted space-y-3 text-center">
    <p>I'm not a professional, just passionate. This isn't medical advice, so please talk to your doctor. It's free advice, and some say it's worth the price you pay. :)</p>
    <p>This advice is mine alone and not affiliated with my employer.</p>
  </section>

  <!-- Submit a question modal -->
  <div id="qmodal" class="hidden fixed inset-0 z-50 bg-black/50 flex items-start md:items-center justify-center p-4 overflow-auto" onclick="if(event.target===this)this.classList.add('hidden')">
    <div class="bg-white rounded-2xl w-full max-w-[680px] my-8 relative">
      <div class="flex items-center justify-between px-5 py-4 border-b border-line">
        <h2 class="font-serif text-lg font-semibold">Submit a question</h2>
        <button type="button" onclick="document.getElementById('qmodal').classList.add('hidden')" class="text-2xl leading-none text-muted hover:text-ink" aria-label="Close">&times;</button>
      </div>
      <iframe
        src="https://docs.google.com/forms/d/e/1FAIpQLSfy1dCeNuqFkFsbK0aLbGKPndMBFgmtQqzmX7AXZ-IEtKU5KQ/viewform?embedded=true"
        class="w-full rounded-b-2xl" style="height:70vh" frameborder="0" marginheight="0" marginwidth="0" title="Submit a question">Loading…</iframe>
    </div>
  </div>
</Base>
