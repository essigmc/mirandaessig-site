---
import Base from '../layouts/Base.astro';
---
<Base title="Personal Kitchen — Miranda Essig" description="To deliver nourishing food conveniently to individuals and families to fuel their lives and pursuits.">
  <section style="background-color:#c76b2e" class="text-white">
    <div class="mx-auto max-w-6xl px-5 py-16">
      <p class="uppercase tracking-widest text-white/80 text-sm">Personal Kitchen</p>
      <h1 class="mt-2 text-3xl md:text-5xl font-extrabold max-w-3xl">Cooking when desired not required</h1>
      <p class="mt-5 text-lg text-white/90 max-w-2xl">To deliver nourishing food conveniently to individuals and families to fuel their lives and pursuits.</p>
    </div>
  </section>
  <section class="mx-auto max-w-6xl px-5 py-14 grid md:grid-cols-3 gap-10">
    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Philosophy</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Cook when desired, not required</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Cost vs nutrition</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Systems</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Meal-prep systems</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">The freeze dryer</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Time & motion studies</a></li>
      </ul>
    </div>    <div>
      <h2 class="text-sm uppercase tracking-wider text-muted">Fuel</h2>
      <ul class="mt-3 space-y-2">
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Macros & micros</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Gut-friendly staples</a></li>
        <li><a href="#" class="text-ink hover:underline underline-offset-4">Tools I use</a></li>
      </ul>
    </div>
  </section>
</Base>
