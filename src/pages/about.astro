---
import Base from '../layouts/Base.astro';
import { href } from '../utils/href.js';
---
<Base title="About — Miranda Essig" description="MBA and product owner obsessed with food, health, and how food businesses run.">
  <h1>About Miranda</h1>
  <div class="about-grid">
    <img src={href('/miranda.png')} alt="Miranda Essig" />
    <div>
      <p>I have an entrepreneurial mind and an MBA, and I work as a product owner — today building the
      software that supports standard operating procedures, and before that at a startup building apps
      that digitized volunteer and participant programs for nonprofits.</p>
      <p>I'm genuinely obsessed with food: how it's made, how the businesses behind it run, and how it
      fuels us. I lift and do cardio through the week, prep meals in bulk (restaurant-kitchen style),
      and love digging into the science of nutrition, the gut biome, and longevity.</p>
      <p>This site is where those two threads meet: the business of food and the science of food. I'm
      building it in the open — mapping the food-service industry, publishing what I learn, and helping
      operators put it to work.</p>
      <p class="muted">Draft bio — I'll refine this from your story page and reading history.</p>
    </div>
  </div>
</Base>
